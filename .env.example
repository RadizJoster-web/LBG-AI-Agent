# ─────────────── Google Drive ───────────────
GOOGLE_CREDS_PATH=credentials/client_secret.json
GOOGLE_TOKEN_PATH=credentials/token.json
DRIVE_PARENT_FOLDER_ID=your_parent_folder_id_here

# ─────────────── Gemini ───────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ─────────────── Sanity ───────────────
SANITY_PROJECT_ID=liftuy21
SANITY_DATASET=production
SANITY_TOKEN=your_sanity_write_token_here
SANITY_API_VERSION=2024-01-01

# ─────────────── Rate Limiting ───────────────
GEMINI_DELAY_SECONDS=4

# ─────────────── Behaviour ───────────────
# If a Gemini genre is missing from the Sanity whitelist, create it (true) or discard it (false)
CREATE_MISSING_GENRES=true
# Process every file on the very first run when no state file exists
DRY_RUN=false
